{{!-- CONSUMABLES (MONTARIA) --}}
{{#if mountConsumables.length}}
<h3 class="inventory-category mt-2">{{localize "SACRAMENTO_RPG.Inventory.MountConsumables"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.QuantityAbbr"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.RemoveFromMountTitle'}}"></i></div>
  </li>
  {{#each mountConsumables as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">
      <input type="number" class="item-quantity uninput" data-item-id="{{item._id}}" value="{{item.system.attributes.quantity.value}}" min="0" />
