<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header western-header flexrow">
    <!-- Left: Identity -->
    <div class="header-identity flexrow">
      <img class="profile-img western-border" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      <div class="header-names flexcol">
        <h1 class="charname">
          <input class="uninput document-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'SACRAMENTO_RPG.Header.NpcNamePlaceholder'}}"/>
        </h1>
        <div class="npc-special-toggle flexrow">
          <input type="checkbox" name="system.attributes.isSpecial.value" {{checked system.attributes.isSpecial.value}} id="isSpecial-{{actor._id}}"/>
          <label for="isSpecial-{{actor._id}}" class="npc-special-label">{{localize "SACRAMENTO_RPG.Header.NpcSpecialToggle"}}</label>
        </div>
      </div>
    </div>
    
    <!-- Right: Mechanics & Badges -->
    <div class="header-mechanics flexrow">
      <div class="level-badge western-border stamp-box" title="{{localize 'SACRAMENTO_RPG.Header.NdCTitle'}}">
        <label>{{localize "SACRAMENTO_RPG.Header.NdC"}}</label>
        <input class="uninput" name="system.attributes.cr.value" type="number" value="{{system.attributes.cr.value}}" min="1" max="6"/>
      </div>

      <div class="header-stats flexrow">
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Actions"}}</label>
          <input class="uninput" type="text" value="{{system.attributes.actions.value}}" readonly/>
        </div>
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Defense"}}</label>
          <input class="uninput" type="number" name="system.attributes.defense.value" value="{{system.attributes.defense.value}}"/>
        </div>
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Initiative"}}</label>
          <input class="uninput" type="text" value="{{localize 'SACRAMENTO_RPG.Header.InitiativeCard'}}" readonly title="{{localize 'SACRAMENTO_RPG.Header.InitiativeCardTitle'}}"/>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs western-tabs" data-group="primary">
    <a class="item" data-tab="status">{{localize "SACRAMENTO_RPG.Tabs.NpcStatus"}}</a>
    <a class="item" data-tab="description">{{localize "SACRAMENTO_RPG.Tabs.NpcBiography"}}</a>
  </nav>

  <section class="sheet-body">
    
    {{!-- TAB FICHA --}}
    <div class="tab status" data-group="primary" data-tab="status">
      
      <!-- TOP: Vida e Dor -->
      <div class="status-top flexrow parchment-box">
        <div class="resource-group life-box wood-border">
          <h2 class="section-title text-red">{{localize "SACRAMENTO_RPG.Status.LifeCircles"}}</h2>
          <div class="circles-row">
            <input class="uninput text-red" type="number" name="system.health.value" value="{{system.health.value}}" min="0" max="{{system.health.max}}"/>
            <span class="max text-red">/ {{system.health.max}}</span>
          </div>
        </div>

        <div class="resource-group pain-box blood-border">
          <h2 class="section-title text-red">{{localize "SACRAMENTO_RPG.Status.PainCircles"}}</h2>
          <div class="circles-row flexrow npc-pain-row">
            <div class="pain-input-container">
              <input class="uninput text-red" type="number" name="system.pain.value" value="{{system.pain.value}}" min="0" max="6"/>
              <span class="max text-red">/ 6</span>
            </div>
            <div class="pain-debuffs npc-pain-reminder-box">
              <p class="npc-pain-reminder-text">{{localize "SACRAMENTO_RPG.Status.NpcPainReminder"}}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- INVENTORY/ABILITIES -->
      <div class="parchment-box mt-2">
        <div class="inventory-header flexrow">
            <h2 class="section-title wood-title inventory-title-inline">{{localize "SACRAMENTO_RPG.Status.NpcArsenalAbilities"}}</h2>
            <div class="slots-tracker {{#if (gt system.slots.value 10)}}overloaded{{/if}}">
            {{localize "SACRAMENTO_RPG.Inventory.Slots"}} {{system.slots.value}} / {{system.slots.max}}
            </div>
        </div>
        <hr class="western-divider"/>
        
         {{> "systems/sacramento-rpg/templates/actor/parts/actor-items.hbs"}}

         <!-- ABILITIES (Custom for NPC sheet since actor-items only renders weapons/equip/consumables) -->
         <h3 class="inventory-category mt-2">{{localize "SACRAMENTO_RPG.Status.NpcAbilitiesPeculiarities"}}</h3>
         <ol class="items-list">
           <li class="item flexrow items-header">
             <div class="item-name">{{localize "SACRAMENTO_RPG.Status.AbilitySingular"}}</div>
             <div class="item-controls"><a class="item-control item-create" data-type="ability"><i class="fas fa-plus"></i></a></div>
           </li>
           {{#each abilities as |item id|}}
           <li class="item flexrow" data-item-id="{{item._id}}">
             <div class="item-name flexrow">
               <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></a>
               <h4>{{item.name}}</h4>
             </div>
             <div class="item-controls flexrow">
               <a class="item-control item-edit" title="{{localize 'SACRAMENTO_RPG.Inventory.EditTitle'}}"><i class="fas fa-edit"></i></a>
               <a class="item-control item-delete" title="{{localize 'SACRAMENTO_RPG.Inventory.DeleteTitle'}}"><i class="fas fa-trash"></i></a>
             </div>
           </li>
           {{/each}}
         </ol>
      </div>
    </div>

    {{!-- TAB BIOGRAFIA --}}
    <div class="tab biography parchment-box" data-group="primary" data-tab="description">
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

  </section>
</form>
