<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header western-header flexrow">
    <!-- Left: Identity -->
    <div class="header-identity flexrow">
      <img class="profile-img western-border" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      <div class="header-names flexcol">
        <h1 class="charname">
          <input class="uninput document-name" name="name" type="text" value="{{actor.name}}"
            placeholder="Nome do Personagem" />
        </h1>
        <h2 class="playername">
          <input class="uninput" name="system.attributes.playerName.value" type="text"
            value="{{system.attributes.playerName.value}}" placeholder="Nome do Jogador" />
        </h2>
      </div>
    </div>

    <!-- Right: Mechanics & Badges -->
    <div class="header-mechanics flexrow">
      <div class="level-xp-container flexrow" style="gap: 10px;">
        <div class="level-badge western-border stamp-box" title="Nível do Personagem">
          <label>NÍVEL</label>
          <input class="uninput" name="system.attributes.level.value" type="number"
            value="{{system.attributes.level.value}}" min="1" />
        </div>
        <div class="xp-badge western-border stamp-box" title="Experiência (XP)">
          <label>XP</label>
          <div class="xp-row flexrow" style="align-items: center; justify-content: center;">
            <input class="uninput text-red" name="system.attributes.xp.value" type="number"
              value="{{system.attributes.xp.value}}" min="0" style="width: 40px; font-size: 1.5em; text-align: center; font-family: 'Rye', cursive;" />
            <span style="font-family: 'Rye', cursive; font-size: 1em; font-weight: bold; margin-left: 5px;">/ {{system.attributes.xp.max}}</span>
          </div>
        </div>
      </div>

      <div class="header-stats flexrow">
        <div class="stat-item stamp-box">
          <label>AÇÕES</label>
          <input class="uninput" type="text" value="{{system.attributes.actions.value}}" readonly />
        </div>
        <div class="stat-item stamp-box">
          <label>MOVIMENTOS</label>
          <input class="uninput" type="text" value="{{system.attributes.moviment.value}}" readonly />
        </div>
        <div class="stat-item stamp-box">
          <label>DEFESA</label>
          <input class="uninput" type="number" name="system.attributes.defense.value"
            value="{{system.attributes.defense.value}}" />
        </div>
        <div class="stat-item stamp-box">
          <label>INICIATIVA</label>
          <input class="uninput" type="text" value="CARTA" readonly title="Use Cartas para Iniciativa!" />
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs western-tabs" data-group="primary">
    <a class="item" data-tab="status">Ficha</a>
    <a class="item" data-tab="inventory">Mochila</a>
    <a class="item" data-tab="mount">Montaria</a>
    <a class="item" data-tab="reputation">Reputação</a>
    <a class="item" data-tab="description">Biografia</a>
  </nav>

  <section class="sheet-body">

    {{!-- TAB FICHA --}}
    <div class="tab status" data-group="primary" data-tab="status">

      {{#if warnings.length}}
      <div class="sheet-warnings blood-border" style="padding: 10px; margin-bottom: 15px; background: rgba(255,0,0,0.1);">
        <h3 style="color: var(--sacramento-red); margin: 0 0 5px 0; font-family: 'Playfair Display', serif;"><i class="fas fa-exclamation-triangle"></i> Ajustes Pendentes (Nível {{system.attributes.level.value}})</h3>
        <ul style="margin: 0; padding-left: 20px; font-size: 0.9em; font-weight: bold; color: var(--sacramento-brown);">
          {{#each warnings}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <!-- TOP: Vida e Dor -->
      <div class="status-top flexrow parchment-box" style="align-items: stretch; gap: 15px;">

        <!-- Left Column: Vida and Teste de Morte -->
        <div class="status-left flexcol" style="flex: 1; gap: 10px; display: flex; flex-direction: column;">

          <!-- Vida -->
          <div class="resource-group life-box wood-border"
            style="flex: 1; text-align: center; padding: 10px; display: flex; flex-direction: column; justify-content: center;">
            <h2 class="section-title wood-title text-red"
              style="font-size: 1.2em; margin-bottom: 10px; border-bottom: 1px solid var(--sacramento-brown);">VIDA</h2>
            <div class="circles-row"
              style="display: flex; justify-content: center; align-items: baseline; font-size: 3em;">
              <input class="uninput text-red" type="text" data-dtype="Number" name="system.health.value"
                value="{{system.health.value}}" />
              <span class="max text-red" style="font-size: 0.5em; margin-left: 5px; font-family: 'Rye', cursive;">/
                {{system.health.max}}</span>
            </div>
          </div>

          <!-- Teste de Morte -->
          <div class="resource-group death-box blood-border" style="padding: 10px; text-align: center;">
            <h2 class="section-title wood-title text-red"
              style="font-size: 1em; margin-bottom: 5px; border-bottom: 1px solid var(--sacramento-red);">TESTE DE MORTE
            </h2>
            <div class="death-saves flexrow"
              style="justify-content: center; gap: 15px; align-items: center; margin-top: 10px;">
              <div class="successes" style="display: flex; gap: 5px; align-items: center;">
                <i class="fas fa-check" style="color: green;"></i>
                <input type="checkbox" name="system.death.success1" {{checked system.death.success1}} />
                <input type="checkbox" name="system.death.success2" {{checked system.death.success2}} />
                <input type="checkbox" name="system.death.success3" {{checked system.death.success3}} />
              </div>
              <div class="failures" style="display: flex; gap: 5px; align-items: center;">
                <i class="fas fa-times" style="color: red;"></i>
                <input type="checkbox" name="system.death.failure1" {{checked system.death.failure1}} />
                <input type="checkbox" name="system.death.failure2" {{checked system.death.failure2}} />
                <input type="checkbox" name="system.death.failure3" {{checked system.death.failure3}} />
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Dor -->
        <div class="resource-group pain-box blood-border"
          style="flex: 2; padding: 10px; display: flex; flex-direction: column;">
          <h2 class="section-title wood-title text-red"
            style="font-size: 1.2em; text-align: center; margin-bottom: 10px; border-bottom: 1px solid var(--sacramento-red);">
            DOR</h2>
          <div class="circles-row flexrow" style="flex: 1; justify-content: center; align-items: center; gap: 20px;">
            <div class="pain-input-container" style="display: flex; align-items: baseline; font-size: 3em;">
              <input class="uninput text-red" type="text" data-dtype="Number" name="system.pain.value"
                value="{{system.pain.value}}" />
              <span class="max text-red" style="font-size: 0.5em; margin-left: 5px; font-family: 'Rye', cursive;">/
                6</span>
            </div>
            <ul class="pain-debuffs" style="margin: 0; padding: 0 15px; font-size: 1.1em;">
              <li class="{{#if (lte system.pain.value 5)}}active{{/if}}">1. Atordoamento (-1 Ação)</li>
              <li class="{{#if (lte system.pain.value 4)}}active{{/if}}">2. Queda (-1 Mov)</li>
              <li class="{{#if (lte system.pain.value 3)}}active{{/if}}">3. Distração</li>
              <li class="{{#if (lte system.pain.value 2)}}active{{/if}}">4. Sangramento</li>
              <li class="{{#if (lte system.pain.value 1)}}active{{/if}}">5. Intimidação</li>
              <li class="{{#if (lte system.pain.value 0)}}active{{/if}}">6. Desorientação</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- BOTTOM: 2 Columns -->
      <div class="grid grid-2col mt-2">
        <!-- Esquerda: Atributos, Antecedentes -->
        <aside class="sidebar-left parchment-box">
          <h2 class="section-title wood-title">ATRIBUTOS</h2>
          <div class="abilities-grid">
            {{#each system.abilities as |ability key|}}
            <div class="ability-card">
              <label class="rollable" data-roll="1d6+@abilities.{{key}}.value"
                data-label="{{ability.label}}">{{ability.label}}</label>
              <input class="uninput" type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" />
            </div>
            {{/each}}
          </div>

          <h2 class="section-title wood-title mt-2">ANTECEDENTES</h2>
          <div class="antecedents-list">
            {{#each system.antecedents as |ant key|}}
            <div class="antecedente-item flexrow">
              <label class="rollable" data-roll="1d6+@antecedents.{{key}}.value"
                data-label="{{ant.label}}">{{ant.label}}</label>
              <input class="uninput" type="number" name="system.antecedents.{{key}}.value" value="{{ant.value}}" />
            </div>
            {{/each}}
          </div>
        </aside>

        <!-- Direita: Redenção, Habilidades -->
        <section class="status-column parchment-box">
          <h2 class="section-title wood-title">TRILHA DE REDENÇÃO</h2>
          <div class="redemption-track">
            {{#each system.redemption as |step key|}}
            <div class="redemption-step flexrow">
              <input type="checkbox" name="system.redemption.{{key}}.checked" {{checked step.checked}} />
              <input class="uninput" type="text" name="system.redemption.{{key}}.text" value="{{step.text}}"
                placeholder="Objetivo..." />
            </div>
            {{/each}}
            <p class="help-text">Complete 6 passos para ganhar +1 Hab, +2 Vida, Vantagem na Init.</p>
          </div>

          <h2 class="section-title wood-title mt-2">HABILIDADES</h2>
          <ol class="items-list">
            {{#each abilities as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}"
              style="padding: 5px 0; border-bottom: 1px dotted var(--sacramento-brown); align-items: center;">
              <div class="item-name flexrow" style="flex: 1; align-items: center; gap: 10px;">
                <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="24"
                    height="24"
                    style="border: 1px solid var(--sacramento-black); border-radius: 2px; vertical-align: middle;" /></a>
                <h4 style="margin: 0; font-family: 'Playfair Display', serif; font-weight: bold; cursor: pointer;"
                  class="rollable" data-roll-type="item">{{item.name}}</h4>
              </div>
              <div class="item-controls flexrow" style="flex: 0 0 50px; justify-content: flex-end; gap: 8px;">
                <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Deletar"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
            <li class="item-create" data-type="ability"
              style="padding: 5px 0; cursor: pointer; color: var(--sacramento-brown); font-weight: bold; font-family: 'Playfair Display', serif;">
              <i class="fas fa-plus"></i> Adicionar Habilidade</li>
          </ol>
        </section>
      </div>
    </div>

    {{!-- TAB MOCHILA --}}
    <div class="tab inventory parchment-box" data-group="primary" data-tab="inventory">
      <div class="inventory-header flexrow" style="justify-content: space-between; align-items: center;">
        <h2 class="section-title wood-title" style="margin-bottom: 0; border: none;">MOCHILA E EQUIPAMENTOS</h2>
        
        <div class="inventory-stats flexrow" style="gap: 15px; align-items: center; justify-content: flex-end;">
          <div class="currency-tracker stamp-box flexrow" style="align-items: center; gap: 5px; padding: 2px 10px;">
            <i class="fas fa-coins" style="color: #b8860b;"></i> <label style="margin: 0;">Dinheiro ($):</label>
            <input class="uninput" type="number" name="system.currency.value" value="{{system.currency.value}}" style="width: 50px; text-align: right; font-weight: bold;" />
          </div>

          <div class="slots-tracker {{#if (gt system.slots.value 10)}}overloaded{{/if}}">
            ESPAÇO: {{system.slots.value}} / {{system.slots.max}}
          </div>
        </div>
      </div>
      <hr style="border-top: 2px solid var(--sacramento-brown); margin-bottom: 15px;" />

      {{> "systems/sacramento-rpg/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- TAB MONTARIA --}}
    <div class="tab mount parchment-box" data-group="primary" data-tab="mount">
      
      {{#if mountWarnings.length}}
      <div class="sheet-warnings blood-border" style="padding: 10px; margin-bottom: 15px; background: rgba(255,0,0,0.1);">
        <h3 style="color: var(--sacramento-red); margin: 0 0 5px 0; font-family: 'Playfair Display', serif;"><i class="fas fa-exclamation-triangle"></i> Ajustes Pendentes na Montaria (Fidelidade {{system.mount.fidelidade.value}})</h3>
        <ul style="margin: 0; padding-left: 20px; font-size: 0.9em; font-weight: bold; color: var(--sacramento-brown);">
          {{#each mountWarnings}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <div class="mount-header flexrow" style="align-items: center; justify-content: space-between; margin-bottom: 15px;">
        <h2 class="section-title wood-title text-red" style="margin: 0;">ESTÁBULO & MONTARIA</h2>
      </div>

      <div class="mount-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <!-- Left: Info & Stats -->
        <div class="mount-info flexcol" style="gap: 10px;">
          <div class="mount-details blood-border" style="padding: 10px;">
            <div class="flexrow" style="gap: 10px; margin-bottom: 5px;">
              <div class="flexcol" style="flex: 2;">
                <label>Nome do Animal</label>
                <input class="uninput" type="text" name="system.mount.name" value="{{system.mount.name}}" placeholder="Carpeado" style="font-size: 1.2em; font-weight: bold; border-bottom: 1px dashed var(--sacramento-brown);"/>
              </div>
              <div class="flexcol" style="flex: 1;">
                <label>Sexo</label>
                <input class="uninput" type="text" name="system.mount.sexo" value="{{system.mount.sexo}}" placeholder="M/F" style="border-bottom: 1px dashed var(--sacramento-brown);"/>
              </div>
            </div>
            <div class="flexcol" style="margin-bottom: 5px;">
              <label>Raça / Tipo</label>
              <input class="uninput" type="text" name="system.mount.animal" value="{{system.mount.animal}}" placeholder="Ex: Cavalo Árabe" style="border-bottom: 1px dashed var(--sacramento-brown);"/>
            </div>
            <div class="flexcol">
              <label>Características (Cicatrizes, Pelagem)</label>
              <textarea name="system.mount.caracteristicas" rows="2" style="background: transparent; border: 1px dashed var(--sacramento-brown); font-family: 'Roboto', sans-serif; resize: none;">{{system.mount.caracteristicas}}</textarea>
            </div>
          </div>

          <!-- Stats (Potencia/Resistencia) -->
          <div class="mount-stats flexrow stamp-box" style="gap: 15px; justify-content: center; align-items: center;">
            <div class="flexcol" style="align-items: center;">
              <div class="flexrow" style="align-items: center; justify-content: center; gap: 5px; margin-bottom: 2px;">
                <label style="margin: 0;">POTÊNCIA</label>
                <a class="rollable" data-roll="1d6 + @mount.potencia.value + @antecedents.montaria.value" data-label="{{#if system.mount.name}}{{system.mount.name}}{{else}}Montaria{{/if}} (Potência)" title="Rolar Potência da Montaria"><img src="systems/sacramento-rpg/icons/common/Roll.svg" width="20" height="20" alt="Roll" style="border: none; cursor: pointer; vertical-align: middle;" /></a>
              </div>
              <input class="uninput" type="number" name="system.mount.potencia.value" value="{{system.mount.potencia.value}}" style="font-size: 2em; text-align: center; width: 50px;" />
            </div>
            <div class="flexcol" style="align-items: center;">
              <label>RESISTÊNCIA</label>
              <input class="uninput" type="number" name="system.mount.resistencia.value" value="{{system.mount.resistencia.value}}" style="font-size: 2em; text-align: center; width: 50px;" />
            </div>
          </div>

          <!-- Vida e Dor da Montaria -->
          <div class="mount-resources flexrow" style="gap: 10px;">
            <div class="resource-group life-box wood-border" style="flex: 1; text-align: center; padding: 10px;">
              <h3 class="wood-title text-red" style="margin: 0 0 5px 0;">VIDA</h3>
              <div class="circles-row flexrow" style="justify-content: center; align-items: baseline;">
                <input class="uninput text-red" style="font-family: 'Rye', cursive; font-size: 2em; width: 40px; text-align: right;" type="number" name="system.mount.health.value" value="{{system.mount.health.value}}" />
                <span style="font-family: 'Rye', cursive; font-size: 1.2em; font-weight: bold; margin-left: 5px;">/ {{system.mount.health.max}}</span>
              </div>
            </div>
            <div class="resource-group pain-box blood-border" style="flex: 1; text-align: center; padding: 10px;">
              <h3 class="wood-title text-red" style="margin: 0 0 5px 0;">DOR</h3>
              <div class="circles-row flexrow" style="justify-content: center; align-items: baseline;">
                <input class="uninput text-red" style="font-family: 'Rye', cursive; font-size: 2em; width: 40px; text-align: right;" type="number" name="system.mount.pain.value" value="{{system.mount.pain.value}}" />
                <span style="font-family: 'Rye', cursive; font-size: 1.2em; font-weight: bold; margin-left: 5px;">/ {{system.mount.pain.max}}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Fidelity & Interactions -->
        <div class="mount-bond flexcol" style="gap: 10px;">
          <!-- Interactions -->
          <div class="mount-interactions wood-border" style="padding: 10px; background: rgba(255,255,255,0.4);">
            <h3 class="wood-title" style="margin: 0 0 10px 0; font-size: 1.1em;"><i class="fas fa-hand-holding-heart"></i> Cuidados Diários</h3>
            <div class="grid grid-2col" style="font-size: 0.9em; font-weight: bold; color: var(--sacramento-black);">
              <label><input type="checkbox" name="system.mount.interacoes.alimentou" {{checked system.mount.interacoes.alimentou}}> Alimentou</label>
              <label><input type="checkbox" name="system.mount.interacoes.escovou" {{checked system.mount.interacoes.escovou}}> Escovou</label>
              <label><input type="checkbox" name="system.mount.interacoes.conversou" {{checked system.mount.interacoes.conversou}}> Conversou</label>
              <label><input type="checkbox" name="system.mount.interacoes.brincou" {{checked system.mount.interacoes.brincou}}> Brincou</label>
            </div>
          </div>

          <!-- Fidelity Table -->
          <div class="mount-fidelity stamp-box" style="padding: 10px;">
            <div class="flexrow" style="align-items: center; justify-content: space-between; border-bottom: 2px solid var(--sacramento-brown); padding-bottom: 5px; margin-bottom: 10px;">
              <h3 class="wood-title" style="margin: 0;">FIDELIDADE</h3>
              <div class="flexrow" style="align-items: center; gap: 5px; flex: 0;">
                <input class="uninput" type="number" name="system.mount.fidelidade.value" value="{{system.mount.fidelidade.value}}" min="0" max="5" style="width: 30px; font-size: 1.5em; text-align: center; font-weight: bold; border-bottom: 1px solid #000;"/>
                <span style="font-weight: bold; font-size: 1.2em;">/ 5</span>
              </div>
            </div>
            
            <ul class="fidelity-list" style="list-style-type: none; padding: 0; margin: 0; font-size: 0.9em; font-family: 'Roboto', sans-serif;">
              <li style="margin-bottom: 5px; opacity: {{fidelityOpacity.l1}};"><b>Nível 1:</b> A montaria atende quando chamada.</li>
              <li style="margin-bottom: 5px; opacity: {{fidelityOpacity.l2}};"><b>Nível 2:</b> Ganha +1 ponto em um atributo.</li>
              <li style="margin-bottom: 5px; opacity: {{fidelityOpacity.l3}};"><b>Nível 3:</b> Vem até você num raio de 500m.</li>
              <li style="margin-bottom: 5px; opacity: {{fidelityOpacity.l4}};"><b>Nível 4:</b> Sem penalidade para saltar obstáculos.</li>
              <li style="margin-bottom: 5px; opacity: {{fidelityOpacity.l5}};"><b>Nível 5:</b> Ganha +1 ponto extra em um atributo.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Mount Inventory -->
      <hr style="border-top: 2px dashed var(--sacramento-brown); margin: 20px 0;"/>
      <div class="mount-bag">
        <div class="flexrow" style="align-items: center; margin-bottom: 10px; gap: 10px;">
          <input type="checkbox" name="system.mount.bolsaDeCarga" {{checked system.mount.bolsaDeCarga}} id="bolsaCheckbox" style="transform: scale(1.5); margin: 0 5px;" />
          <label for="bolsaCheckbox" style="font-family: 'Playfair Display', serif; font-size: 1.2em; font-weight: bold; color: var(--sacramento-black); cursor: pointer;">A montaria possui Bolsa de Carga?</label>
        </div>

        {{#if system.mount.bolsaDeCarga}}
          <div class="mount-inventory-content stamp-box">
            <h3 class="wood-title" style="margin-top: 0; margin-bottom: 5px;">ITENS NA BOLSA DE CARGA</h3>
            <p style="font-size: 0.8em; font-style: italic; margin-top: 0;">Use o ícone <i class="fas fa-horse"></i> na Mochila principal para mover itens para cá.</p>
            
            {{> "systems/sacramento-rpg/templates/actor/parts/actor-mount-items.hbs"}}
          </div>
        {{else}}
          <p style="font-size: 0.9em; font-style: italic; color: #666; margin-left: 30px;">O animal precisa estar equipado com uma Bolsa de Carga para carregar itens do seu inventário.</p>
        {{/if}}
      </div>
    </div>

    {{!-- TAB REPUTAÇÃO --}}
    <div class="tab reputation parchment-box" data-group="primary" data-tab="reputation">
      <h2 class="section-title wood-title text-red">REPUTAÇÃO & PROCURADO</h2>
      
      <div class="wanted-poster blood-border" style="text-align: center; padding: 20px; background: url('systems/sacramento-rpg/assets/ui/parchment.webp');">
        <h1 style="font-family: 'Rye', cursive; font-size: 3em; margin: 0; color: #3a1f04;">WANTED</h1>
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.5em; margin: 5px 0 15px 0; color: #3a1f04;">DEAD OR ALIVE</h2>
        
        <div class="bounty-amount flexrow" style="justify-content: center; align-items: baseline; gap: 5px;">
          <span style="font-family: 'Rye', cursive; font-size: 2.5em; color: var(--sacramento-red);">$</span>
          <input class="uninput text-red" type="number" name="system.reputation.value" value="{{system.reputation.value}}" style="font-family: 'Rye', cursive; font-size: 4em; width: 120px; text-align: center; border-bottom: 2px dashed var(--sacramento-red) !important;"/>
        </div>
        
        <p style="font-family: 'Roboto', sans-serif; font-style: italic; margin-top: 15px;">
          Quanto maior sua recompensa, mais agentes da lei e caçadores irão te perseguir!
        </p>
      </div>

      <h3 class="wood-title mt-2" style="font-size: 1.1em;">Tabela de Crimes (Referência)</h3>
      <div class="crimes-table" style="font-size: 0.9em; column-count: 2; column-gap: 20px;">
        <ul style="list-style-type: none; padding: 0; margin: 0;">
          <li><b>$10</b> - Vandalismo</li>
          <li><b>$10</b> - Insultar agentes da lei</li>
          <li><b>$20</b> - Agressão a cavalos</li>
          <li><b>$50</b> - Agressão</li>
          <li><b>$50</b> - Destruição de propriedade</li>
          <li><b>$100</b> - Agressão contra agentes</li>
          <li><b>$100</b> - Arrombamento de cofre</li>
          <li><b>$100</b> - Assalto</li>
          <li><b>$100</b> - Furto</li>
