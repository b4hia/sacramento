<header class="sheet-header western-header flexrow">
  <div class="header-identity flexrow">
    <img class="profile-img western-border" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-names flexcol">
      <h1 class="charname">
        <input class="uninput document-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SACRAMENTO_RPG.Header.ItemNamePlaceholder'}}" />
      </h1>
    </div>
  </div>
</header>
