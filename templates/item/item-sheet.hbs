<form class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/sacramento-rpg/templates/item/parts/item-header.hbs"}}

  <nav class="sheet-tabs tabs western-tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "SACRAMENTO_RPG.Tabs.Description"}}</a>
    <a class="item" data-tab="details">{{localize "SACRAMENTO_RPG.Tabs.Details"}}</a>
    <a class="item" data-tab="effects">{{localize "SACRAMENTO_RPG.Tabs.Effects"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab description" data-group="primary" data-tab="description">
      {{> "systems/sacramento-rpg/templates/item/parts/item-description.hbs"}}
    </div>

    <div class="tab details" data-group="primary" data-tab="details">
      {{> (concat "systems/sacramento-rpg/templates/item/details/details-" item.type ".hbs")}}
    </div>

    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> "systems/sacramento-rpg/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</form>