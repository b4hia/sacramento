{{!-- WEAPONS --}}
<h3 class="inventory-category">Armas</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">Nome</div>
    <div class="item-detail">Balas</div>
    <div class="item-detail">Coldre?</div>
    <div class="item-controls"><a class="item-control item-create" data-type="weapon"><i class="fas fa-plus"></i></a></div>
  </li>
  {{#each weapons as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">
      <input type="number" class="item-ammo" data-item-id="{{item._id}}" value="{{item.system.attributes.ammo.value}}" min="0" max="{{item.system.attributes.ammo.max}}" style="width:40px;" /> / {{item.system.attributes.ammo.max}}
    </div>
    <div class="item-detail">
      <input type="checkbox" class="item-equip" data-item-id="{{item._id}}" {{checked item.system.attributes.isEquipped.value}} title="No Coldre" />
    </div>
    <div class="item-controls">
      <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
      <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>

{{!-- EQUIPMENT --}}
<h3 class="inventory-category mt-2">Equipamentos</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">Nome</div>
    <div class="item-detail">Espaços</div>
