{{!-- WEAPONS (MONTARIA) --}}
{{#if mountWeapons.length}}
<h3 class="inventory-category">{{localize "SACRAMENTO_RPG.Inventory.MountWeapons"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.Bullets"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.RemoveFromMountTitle'}}"></i></div>
  </li>
  {{#each mountWeapons as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">
      {{#if item.system.attributes.ammo.max}}
      <input type="number" class="item-ammo" data-item-id="{{item._id}}" value="{{item.system.attributes.ammo.value}}" min="0" max="{{item.system.attributes.ammo.max}}" /> / {{item.system.attributes.ammo.max}}
      {{else}}
      -
      {{/if}}
    </div>
    <div class="item-detail">
      <a class="item-control item-mount active" title="{{localize 'SACRAMENTO_RPG.Inventory.ReturnToBackpackTitle'}}" data-item-id="{{item._id}}"><i class="fas fa-horse"></i></a>
    </div>
  </li>
  {{/each}}
</ol>
{{/if}}

{{!-- EQUIPMENT (MONTARIA) --}}
{{#if mountEquipment.length}}
<h3 class="inventory-category mt-2">{{localize "SACRAMENTO_RPG.Inventory.MountEquipment"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.SlotsCol"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.RemoveFromMountTitle'}}"></i></div>
  </li>
  {{#each mountEquipment as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
