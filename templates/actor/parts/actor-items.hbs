<div class="inventory-summary flexrow">
  <div><strong>{{localize "SACRAMENTO_RPG.Inventory.BackpackSlots"}}</strong> {{system.slots.value}} / {{system.slots.max}}</div>
  <div><strong>{{localize "SACRAMENTO_RPG.Inventory.MountSlots"}}</strong> {{system.mount.slots.value}} / {{system.mount.slots.max}}</div>
</div>

{{!-- WEAPONS --}}
<h3 class="inventory-category">{{localize "SACRAMENTO_RPG.Inventory.Weapons"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.Bullets"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.Holster"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.OnMountTitle'}}"></i></div>
    <div class="item-controls"><a class="item-control item-create" data-type="weapon"><i class="fas fa-plus"></i></a></div>
  </li>
  {{#each weapons as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">
      {{#if item.system.attributes.ammo.max}}
      <input type="number" class="item-ammo" data-item-id="{{item._id}}" value="{{item.system.attributes.ammo.value}}" min="0" max="{{item.system.attributes.ammo.max}}" /> / {{item.system.attributes.ammo.max}}
      <a class="item-control item-reload" title="{{localize 'SACRAMENTO_RPG.Inventory.ReloadTitle'}}"><i class="fas fa-sync"></i></a>
      {{else}}
      -
      {{/if}}
    </div>
    <div class="item-detail">
      <input type="checkbox" class="item-equip" data-item-id="{{item._id}}" {{checked item.system.attributes.isEquipped.value}} title="{{localize 'SACRAMENTO_RPG.Inventory.HolsterTitle'}}" />
    </div>
    <div class="item-detail">
      <a class="item-control item-mount {{#if item.system.attributes.isMountItem.value}}active{{/if}}" title="{{localize 'SACRAMENTO_RPG.Inventory.StoreOnMountTitle'}}" data-item-id="{{item._id}}"><i class="fas fa-horse"></i></a>
    </div>
    <div class="item-controls">
      <a class="item-control item-edit" title="{{localize 'SACRAMENTO_RPG.Inventory.EditTitle'}}"><i class="fas fa-edit"></i></a>
      <a class="item-control item-delete" title="{{localize 'SACRAMENTO_RPG.Inventory.DeleteTitle'}}"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>

{{!-- EQUIPMENT --}}
<h3 class="inventory-category mt-2">{{localize "SACRAMENTO_RPG.Inventory.Equipment"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.SlotsCol"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.Worn"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.OnMountTitle'}}"></i></div>
    <div class="item-controls"><a class="item-control item-create" data-type="equipment"><i class="fas fa-plus"></i></a></div>
  </li>
  {{#each equipment as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">{{item.system.attributes.slots.value}}</div>
    <div class="item-detail">
      <input type="checkbox" class="item-equip" data-item-id="{{item._id}}" {{checked item.system.attributes.isEquipped.value}} title="{{localize 'SACRAMENTO_RPG.Inventory.WornTitle'}}" />
    </div>
    <div class="item-detail">
      <a class="item-control item-mount {{#if item.system.attributes.isMountItem.value}}active{{/if}}" title="{{localize 'SACRAMENTO_RPG.Inventory.StoreOnMountTitle'}}" data-item-id="{{item._id}}"><i class="fas fa-horse"></i></a>
    </div>
    <div class="item-controls">
      <a class="item-control item-edit" title="{{localize 'SACRAMENTO_RPG.Inventory.EditTitle'}}"><i class="fas fa-edit"></i></a>
      <a class="item-control item-delete" title="{{localize 'SACRAMENTO_RPG.Inventory.DeleteTitle'}}"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>

{{!-- CONSUMABLES --}}
<h3 class="inventory-category mt-2">{{localize "SACRAMENTO_RPG.Inventory.Consumables"}}</h3>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "SACRAMENTO_RPG.Inventory.Name"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.QuantityAbbr"}}</div>
    <div class="item-detail">{{localize "SACRAMENTO_RPG.Inventory.Equipped"}}</div>
    <div class="item-detail"><i class="fas fa-horse" title="{{localize 'SACRAMENTO_RPG.Inventory.OnMountTitle'}}"></i></div>
    <div class="item-controls"><a class="item-control item-create" data-type="consumable"><i class="fas fa-plus"></i></a></div>
  </li>
  {{#each consumables as |item id|}}
  <li class="item flexrow" data-item-id="{{item._id}}">
    <div class="item-name">
      <a class="rollable" data-roll-type="item"><img src="{{item.img}}" width="24" height="24"/></a>
      <h4>{{item.name}}</h4>
    </div>
    <div class="item-detail">
      <input type="number" class="item-quantity uninput" data-item-id="{{item._id}}" value="{{item.system.attributes.quantity.value}}" min="0" />
    </div>
    <div class="item-detail">
      <input type="checkbox" class="item-equip" data-item-id="{{item._id}}" {{checked item.system.attributes.isEquipped.value}} title="{{localize 'SACRAMENTO_RPG.Inventory.EquippedTitle'}}" />
    </div>
    <div class="item-detail">
      <a class="item-control item-mount {{#if item.system.attributes.isMountItem.value}}active{{/if}}" title="{{localize 'SACRAMENTO_RPG.Inventory.StoreOnMountTitle'}}" data-item-id="{{item._id}}"><i class="fas fa-horse"></i></a>
    </div>
    <div class="item-controls">
      <a class="item-control item-edit" title="{{localize 'SACRAMENTO_RPG.Inventory.EditTitle'}}"><i class="fas fa-edit"></i></a>
      <a class="item-control item-delete" title="{{localize 'SACRAMENTO_RPG.Inventory.DeleteTitle'}}"><i class="fas fa-trash"></i></a>
    </div>
  </li>
  {{/each}}
</ol>