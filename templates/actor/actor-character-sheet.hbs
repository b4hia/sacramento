<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">
  <header class="sheet-header western-header flexrow">
    <!-- Left: Identity -->
    <div class="header-identity flexrow">
      <img class="profile-img western-border" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      <div class="header-names flexcol">
        <h1 class="charname">
          <input class="uninput document-name" name="name" type="text" value="{{actor.name}}"
            placeholder="{{localize 'SACRAMENTO_RPG.Header.CharacterNamePlaceholder'}}" />
        </h1>
        <h2 class="playername">
          <input class="uninput" name="system.attributes.playerName.value" type="text"
            value="{{system.attributes.playerName.value}}" placeholder="{{localize 'SACRAMENTO_RPG.Header.PlayerNamePlaceholder'}}" />
        </h2>
      </div>
    </div>

    <!-- Right: Mechanics & Badges -->
    <div class="header-mechanics flexrow">
      <div class="level-xp-container flexrow">
        <div class="level-badge western-border stamp-box" title="{{localize 'SACRAMENTO_RPG.Header.LevelTitle'}}">
          <label>{{localize "SACRAMENTO_RPG.Header.Level"}}</label>
          <input class="uninput" name="system.attributes.level.value" type="number"
            value="{{system.attributes.level.value}}" min="1" />
        </div>
        <div class="xp-badge western-border stamp-box" title="{{localize 'SACRAMENTO_RPG.Header.XPTitle'}}">
          <label>{{localize "SACRAMENTO_RPG.Header.XP"}}</label>
          <div class="xp-row flexrow">
            <input class="uninput text-red xp-input" name="system.attributes.xp.value" type="number"
              value="{{system.attributes.xp.value}}" min="0" />
            <span class="xp-max-sep">/ {{system.attributes.xp.max}}</span>
          </div>
        </div>
      </div>

      <div class="header-stats flexrow">
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Actions"}}</label>
          <input class="uninput" type="text" value="{{system.attributes.actions.value}}" readonly />
        </div>
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Movements"}}</label>
          <input class="uninput" type="text" value="{{system.attributes.movement.value}}" readonly />
        </div>
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Defense"}}</label>
          <input class="uninput" type="number" name="system.attributes.defense.value"
            value="{{system.attributes.defense.value}}" />
        </div>
        <div class="stat-item stamp-box">
          <label>{{localize "SACRAMENTO_RPG.Header.Initiative"}}</label>
          <input class="uninput" type="text" value="{{localize 'SACRAMENTO_RPG.Header.InitiativeCard'}}" readonly title="{{localize 'SACRAMENTO_RPG.Header.InitiativeCardTitle'}}" />
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs western-tabs" data-group="primary">
    <a class="item" data-tab="status">{{localize "SACRAMENTO_RPG.Tabs.Status"}}</a>
    <a class="item" data-tab="inventory">{{localize "SACRAMENTO_RPG.Tabs.Inventory"}}</a>
    <a class="item" data-tab="mount">{{localize "SACRAMENTO_RPG.Tabs.Mount"}}</a>
    <a class="item" data-tab="reputation">{{localize "SACRAMENTO_RPG.Tabs.Reputation"}}</a>
    <a class="item" data-tab="description">{{localize "SACRAMENTO_RPG.Tabs.Biography"}}</a>
  </nav>

  <section class="sheet-body">

    {{!-- TAB FICHA --}}
    <div class="tab status" data-group="primary" data-tab="status">

      {{#if warnings.length}}
      <div class="sheet-warnings blood-border">
        <h3 class="warnings-title"><i
            class="fas fa-exclamation-triangle"></i> {{localize "SACRAMENTO_RPG.Status.PendingAdjustments"}} ({{localize "SACRAMENTO_RPG.Status.LevelLabel"}} {{system.attributes.level.value}})</h3>
        <ul class="warnings-list">
          {{#each warnings}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <!-- TOP: Vida e Dor -->
      <div class="status-top flexrow parchment-box">

        <!-- Left Column: Vida and Teste de Morte -->
        <div class="status-left flexcol">

          <!-- Vida -->
          <div class="resource-group life-box wood-border">
            <h2 class="section-title wood-title text-red resource-heading">{{localize "SACRAMENTO_RPG.Status.Life"}}</h2>
            <div class="circles-row">
              <input class="uninput text-red" type="text" data-dtype="Number" name="system.health.value"
                value="{{system.health.value}}" />
              <span class="max text-red">/ {{system.health.max}}</span>
            </div>
          </div>

          <!-- Teste de Morte -->
          <div class="resource-group death-box blood-border">
            <h2 class="section-title wood-title text-red death-save-title">
              <a class="rollable death-save-roll" data-roll-type="death-save" title="{{localize 'SACRAMENTO_RPG.Status.DeathSaveTitle'}}">
                {{localize "SACRAMENTO_RPG.Status.DeathSave"}}
                <img src="systems/sacramento-rpg/icons/common/Roll.svg" width="18" height="18" alt="{{localize 'SACRAMENTO_RPG.Status.RollAlt'}}" class="roll-icon" />
              </a>
            </h2>
            <div class="death-saves flexrow">
              <div class="successes">
                <i class="fas fa-check death-icon-success" title="{{localize 'SACRAMENTO_RPG.Status.DeathSuccessTitle'}}"></i>
                <input type="checkbox" name="system.death.success1" {{checked system.death.success1}} />
                <input type="checkbox" name="system.death.success2" {{checked system.death.success2}} />
                <input type="checkbox" name="system.death.success3" {{checked system.death.success3}} />
              </div>
              <div class="failures">
                <i class="fas fa-times death-icon-failure" title="{{localize 'SACRAMENTO_RPG.Status.DeathFailureTitle'}}"></i>
                <input type="checkbox" name="system.death.failure1" {{checked system.death.failure1}} />
                <input type="checkbox" name="system.death.failure2" {{checked system.death.failure2}} />
                <input type="checkbox" name="system.death.failure3" {{checked system.death.failure3}} />
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Dor -->
        <div class="resource-group pain-box blood-border">
          <h2 class="section-title wood-title text-red pain-heading">
            {{localize "SACRAMENTO_RPG.Status.Pain"}}</h2>
          <div class="circles-row flexrow">
            <div class="pain-input-container">
              <input class="uninput text-red" type="text" data-dtype="Number" name="system.pain.value"
                value="{{system.pain.value}}" />
              <span class="max text-red">/ 6</span>
            </div>
            <ul class="pain-debuffs">
              <li class="{{#if (lte system.pain.value 5)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff1"}}</li>
              <li class="{{#if (lte system.pain.value 4)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff2"}}</li>
              <li class="{{#if (lte system.pain.value 3)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff3"}}</li>
              <li class="{{#if (lte system.pain.value 2)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff4"}}</li>
              <li class="{{#if (lte system.pain.value 1)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff5"}}</li>
              <li class="{{#if (lte system.pain.value 0)}}active{{/if}}">{{localize "SACRAMENTO_RPG.Status.PainDebuff6"}}</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- BOTTOM: 2 Columns -->
      <div class="grid grid-2col mt-2">
        <!-- Esquerda: Atributos, Antecedentes -->
        <aside class="sidebar-left parchment-box">
          <h2 class="section-title wood-title">{{localize "SACRAMENTO_RPG.Status.Attributes"}}</h2>
          <div class="abilities-grid">
            {{#each system.abilities as |ability key|}}
            <div class="ability-card">
              <label class="rollable" data-roll="1d6+@abilities.{{key}}.value"
                data-label="{{ability.label}}">{{ability.label}}</label>
              <input class="uninput" type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" />
            </div>
            {{/each}}
          </div>

          <h2 class="section-title wood-title mt-2">{{localize "SACRAMENTO_RPG.Status.Antecedents"}}</h2>
          <div class="antecedents-list">
            {{#each system.antecedents as |ant key|}}
            <div class="antecedente-item flexrow">
              <label class="rollable" data-roll="1d6+@antecedents.{{key}}.value"
                data-label="{{ant.label}}">{{ant.label}}</label>
              <input class="uninput" type="number" name="system.antecedents.{{key}}.value" value="{{ant.value}}" />
            </div>
            {{/each}}
          </div>
        </aside>

        <!-- Direita: Redenção, Habilidades -->
        <section class="status-column parchment-box">
          <h2 class="section-title wood-title">{{localize "SACRAMENTO_RPG.Status.RedemptionTrack"}}</h2>
          <div class="redemption-track">
            {{#each system.redemption as |step key|}}
            <div class="redemption-step flexrow">
              <input type="checkbox" name="system.redemption.{{key}}.checked" {{checked step.checked}} />
              <input class="uninput" type="text" name="system.redemption.{{key}}.text" value="{{step.text}}"
                placeholder="{{localize 'SACRAMENTO_RPG.Status.RedemptionGoalPlaceholder'}}" />
            </div>
            {{/each}}
            <p class="help-text">{{localize "SACRAMENTO_RPG.Status.RedemptionHelp"}}</p>
          </div>

          <h2 class="section-title wood-title mt-2">{{localize "SACRAMENTO_RPG.Status.Abilities"}}</h2>
          <ol class="items-list abilities-list">
            {{#each abilities as |item id|}}
            <li class="item flexrow ability-item-row" data-item-id="{{item._id}}">
              <div class="item-name flexrow ability-item-name">
                <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="24"
                    height="24" class="ability-item-img" /></a>
                <h4 class="rollable ability-item-title" data-roll-type="item">{{item.name}}</h4>
              </div>
              <div class="item-controls flexrow">
                <a class="item-control item-edit" title="{{localize 'SACRAMENTO_RPG.Inventory.EditTitle'}}"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="{{localize 'SACRAMENTO_RPG.Inventory.DeleteTitle'}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
            <li class="item-create ability-create-btn" data-type="ability">
              <i class="fas fa-plus"></i> {{localize "SACRAMENTO_RPG.Status.AddAbility"}}
            </li>
          </ol>
        </section>
      </div>
    </div>

    {{!-- TAB MOCHILA --}}
    <div class="tab inventory parchment-box" data-group="primary" data-tab="inventory">
      <div class="inventory-header flexrow">
        <h2 class="section-title wood-title inventory-title-inline">{{localize "SACRAMENTO_RPG.Inventory.Header"}}</h2>

        <div class="inventory-stats flexrow">
          <div class="currency-tracker stamp-box flexrow">
            <i class="fas fa-coins coin-icon"></i> <label class="currency-label">{{localize "SACRAMENTO_RPG.Inventory.Currency"}}</label>
            <input class="uninput currency-input" type="number" name="system.currency.value" value="{{system.currency.value}}" />
          </div>

          <div class="slots-tracker {{#if (gt system.slots.value 10)}}overloaded{{/if}}">
            {{localize "SACRAMENTO_RPG.Inventory.Slots"}} {{system.slots.value}} / {{system.slots.max}}
          </div>
        </div>
      </div>
      <hr class="western-divider" />

      {{> "systems/sacramento-rpg/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- TAB MONTARIA --}}
    <div class="tab mount parchment-box" data-group="primary" data-tab="mount">

      {{#if mountWarnings.length}}
      <div class="sheet-warnings blood-border">
        <h3 class="warnings-title"><i
            class="fas fa-exclamation-triangle"></i> {{localize "SACRAMENTO_RPG.Mount.PendingAdjustments"}} ({{localize "SACRAMENTO_RPG.Mount.FidelityLabel"}}
          {{system.mount.loyalty.value}})</h3>
        <ul class="warnings-list">
          {{#each mountWarnings}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <div class="mount-header flexrow">
        <h2 class="section-title wood-title text-red mount-title-inline">{{localize "SACRAMENTO_RPG.Mount.Header"}}</h2>
      </div>

      <div class="mount-grid">
        <!-- Left: Info & Stats -->
        <div class="mount-info flexcol">
          <div class="mount-details blood-border">
            <div class="flexrow mount-row-gap">
              <div class="flexcol mount-name-col">
                <label>{{localize "SACRAMENTO_RPG.Mount.Name"}}</label>
                <input class="uninput mount-name-input" type="text" name="system.mount.name" value="{{system.mount.name}}"
                  placeholder="{{localize 'SACRAMENTO_RPG.Mount.NamePlaceholder'}}" />
              </div>
              <div class="flexcol mount-sex-col">
                <label>{{localize "SACRAMENTO_RPG.Mount.Sex"}}</label>
                <input class="uninput mount-dashed-input" type="text" name="system.mount.sex" value="{{system.mount.sex}}"
                  placeholder="{{localize 'SACRAMENTO_RPG.Mount.SexPlaceholder'}}" />
              </div>
            </div>
            <div class="flexcol mount-breed-row">
              <label>{{localize "SACRAMENTO_RPG.Mount.Breed"}}</label>
              <input class="uninput mount-dashed-input" type="text" name="system.mount.animal" value="{{system.mount.animal}}"
                placeholder="{{localize 'SACRAMENTO_RPG.Mount.BreedPlaceholder'}}" />
            </div>
            <div class="flexcol">
              <label>{{localize "SACRAMENTO_RPG.Mount.Traits"}}</label>
              <textarea class="mount-traits-textarea" name="system.mount.traits" rows="2">{{system.mount.traits}}</textarea>
            </div>
          </div>

          <!-- Stats (Potency/Endurance) -->
          <div class="mount-stats flexrow stamp-box">
            <div class="flexcol mount-stat-col">
              <div class="flexrow mount-stat-label-row">
                <label class="mount-stat-label">{{localize "SACRAMENTO_RPG.Mount.Potency"}}</label>
                <a class="rollable" data-roll="1d6 + @mount.potency.value + @antecedents.montaria.value"
                  data-label="{{#if system.mount.name}}{{system.mount.name}}{{else}}{{localize 'SACRAMENTO_RPG.Tabs.Mount'}}{{/if}} ({{localize 'SACRAMENTO_RPG.Mount.Potency'}})"
                  title="{{localize 'SACRAMENTO_RPG.Mount.PotencyRollTitle'}}"><img src="systems/sacramento-rpg/icons/common/Roll.svg" width="20"
                    height="20" alt="{{localize 'SACRAMENTO_RPG.Status.RollAlt'}}" class="roll-icon" /></a>
              </div>
              <input class="uninput mount-stat-input" type="number" name="system.mount.potency.value"
                value="{{system.mount.potency.value}}" />
            </div>
            <div class="flexcol mount-stat-col">
              <label>{{localize "SACRAMENTO_RPG.Mount.Resistance"}}</label>
              <input class="uninput mount-stat-input" type="number" name="system.mount.endurance.value"
                value="{{system.mount.endurance.value}}" />
            </div>
          </div>

          <!-- Vida e Dor da Montaria -->
          <div class="mount-resources flexrow">
            <div class="resource-group life-box wood-border mount-resource-box">
              <h3 class="wood-title text-red mount-resource-title">{{localize "SACRAMENTO_RPG.Status.Life"}}</h3>
              <div class="circles-row flexrow mount-circles-row">
                <input class="uninput text-red mount-circle-input" type="number"
                  name="system.mount.health.value" value="{{system.mount.health.value}}" />
                <span class="mount-circle-max">/ {{system.mount.health.max}}</span>
              </div>
            </div>
            <div class="resource-group pain-box blood-border mount-resource-box">
              <h3 class="wood-title text-red mount-resource-title">{{localize "SACRAMENTO_RPG.Status.Pain"}}</h3>
              <div class="circles-row flexrow mount-circles-row">
                <input class="uninput text-red mount-circle-input" type="number"
                  name="system.mount.pain.value" value="{{system.mount.pain.value}}" />
                <span class="mount-circle-max">/ {{system.mount.pain.max}}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Fidelity & Interactions -->
        <div class="mount-bond flexcol">
          <!-- Interactions -->
          <div class="mount-interactions wood-border">
            <h3 class="wood-title mount-care-title"><i
                class="fas fa-hand-holding-heart"></i> {{localize "SACRAMENTO_RPG.Mount.DailyCare"}}</h3>
            <div class="grid grid-2col mount-care-grid">
              <label><input type="checkbox" name="system.mount.interactions.fed" {{checked
                  system.mount.interactions.fed}}> {{localize "SACRAMENTO_RPG.Mount.Fed"}}</label>
              <label><input type="checkbox" name="system.mount.interactions.brushed" {{checked
                  system.mount.interactions.brushed}}> {{localize "SACRAMENTO_RPG.Mount.Brushed"}}</label>
              <label><input type="checkbox" name="system.mount.interactions.talked" {{checked
                  system.mount.interactions.talked}}> {{localize "SACRAMENTO_RPG.Mount.Talked"}}</label>
              <label><input type="checkbox" name="system.mount.interactions.played" {{checked
                  system.mount.interactions.played}}> {{localize "SACRAMENTO_RPG.Mount.Played"}}</label>
            </div>
          </div>

          <!-- Fidelity Table -->
          <div class="mount-fidelity stamp-box">
            <div class="flexrow mount-fidelity-header">
              <h3 class="wood-title mount-title-inline">{{localize "SACRAMENTO_RPG.Mount.Fidelity"}}</h3>
              <div class="flexrow mount-fidelity-counter">
                <input class="uninput mount-fidelity-input" type="number" name="system.mount.loyalty.value"
                  value="{{system.mount.loyalty.value}}" min="0" max="5" />
                <span class="mount-fidelity-max">/ 5</span>
              </div>
            </div>

            <ul class="fidelity-list">
              <li class="fidelity-step {{fidelityClasses.l1}}"><b>{{localize "SACRAMENTO_RPG.Mount.FidelityL1Label"}}</b> {{localize "SACRAMENTO_RPG.Mount.FidelityL1Text"}}</li>
              <li class="fidelity-step {{fidelityClasses.l2}}"><b>{{localize "SACRAMENTO_RPG.Mount.FidelityL2Label"}}</b> {{localize "SACRAMENTO_RPG.Mount.FidelityL2Text"}}</li>
              <li class="fidelity-step {{fidelityClasses.l3}}"><b>{{localize "SACRAMENTO_RPG.Mount.FidelityL3Label"}}</b> {{localize "SACRAMENTO_RPG.Mount.FidelityL3Text"}}</li>
              <li class="fidelity-step {{fidelityClasses.l4}}"><b>{{localize "SACRAMENTO_RPG.Mount.FidelityL4Label"}}</b> {{localize "SACRAMENTO_RPG.Mount.FidelityL4Text"}}</li>
              <li class="fidelity-step {{fidelityClasses.l5}}"><b>{{localize "SACRAMENTO_RPG.Mount.FidelityL5Label"}}</b> {{localize "SACRAMENTO_RPG.Mount.FidelityL5Text"}}</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Mount Inventory -->
      <hr class="mount-dashed-divider" />
      <div class="mount-bag">
        <div class="flexrow mount-bag-toggles">
          <input type="checkbox" name="system.mount.hasSaddlebag" {{checked system.mount.hasSaddlebag}}
            id="bolsaCheckbox" class="mount-bag-checkbox" />
          <label for="bolsaCheckbox" class="mount-bag-label">{{localize "SACRAMENTO_RPG.Mount.HasSaddlebag"}}</label>

          <input type="checkbox" name="system.mount.hasWagon" {{checked system.mount.hasWagon}} id="carrocaCheckbox"
            class="mount-bag-checkbox mount-wagon-checkbox" />
          <label for="carrocaCheckbox" class="mount-bag-label">{{localize "SACRAMENTO_RPG.Mount.HasWagon"}}</label>
        </div>

        {{#if system.mount.hasSaddlebag}}
        <div class="mount-inventory-content stamp-box">
          <h3 class="wood-title mount-bag-title">{{localize "SACRAMENTO_RPG.Mount.SaddlebagItemsHeader"}}</h3>
          <p class="mount-bag-help">{{localize "SACRAMENTO_RPG.Mount.SaddlebagHelpPrefix"}} <i class="fas fa-horse"></i> {{localize "SACRAMENTO_RPG.Mount.SaddlebagHelpSuffix"}}</p>

          {{> "systems/sacramento-rpg/templates/actor/parts/actor-mount-items.hbs"}}
        </div>
        {{else}}
        <p class="mount-no-bag-hint">{{localize "SACRAMENTO_RPG.Mount.NoSaddlebagHint"}}</p>
        {{/if}}
      </div>
    </div>

    {{!-- TAB REPUTAÇÃO --}}
    <div class="tab reputation parchment-box" data-group="primary" data-tab="reputation">
      <h2 class="section-title wood-title text-red">{{localize "SACRAMENTO_RPG.Reputation.Header"}}</h2>

      <div class="wanted-poster blood-border">
        <h1 class="wanted-title">{{localize "SACRAMENTO_RPG.Reputation.Wanted"}}</h1>
        <h2 class="wanted-subtitle">{{localize "SACRAMENTO_RPG.Reputation.DeadOrAlive"}}</h2>

        <div class="bounty-amount flexrow">
          <span class="bounty-symbol">$</span>
          <input class="uninput text-red bounty-input" type="number" name="system.reputation.value"
            value="{{system.reputation.value}}" />
        </div>

        <p class="bounty-hint">
          {{localize "SACRAMENTO_RPG.Reputation.BountyHint"}}
        </p>
      </div>

      <h3 class="wood-title mt-2 crimes-table-heading">{{localize "SACRAMENTO_RPG.Reputation.CrimesTableTitle"}}</h3>
      <div class="crimes-table">
        <ul class="crimes-list">
          <li><b>$10</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeVandalism"}}</li>
          <li><b>$10</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeInsultLaw"}}</li>
          <li><b>$20</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeHorseAssault"}}</li>
          <li><b>$50</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeAssault"}}</li>
          <li><b>$50</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimePropertyDestruction"}}</li>
          <li><b>$100</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeLawAssault"}}</li>
          <li><b>$100</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeSafeCracking"}}</li>
          <li><b>$100</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeRobbery"}}</li>
          <li><b>$100</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeTheft"}}</li>
          <li><b>$150</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimePropertyTheft"}}</li>
          <li><b>$200</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeHorseMurder"}}</li>
          <li><b>$200</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeArson"}}</li>
          <li><b>$200</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeStagecoachRobbery"}}</li>
          <li><b>$200</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeKidnapping"}}</li>
          <li><b>$250</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeHorseTheft"}}</li>
          <li><b>$300</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeLawKidnapping"}}</li>
          <li><b>$400</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeMurder"}}</li>
          <li><b>$400</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeTrainRobbery"}}</li>
          <li><b>$500</b> - {{localize "SACRAMENTO_RPG.Reputation.CrimeLawMurder"}}</li>
        </ul>
      </div>
    </div>

    {{!-- TAB BIOGRAFIA --}}
